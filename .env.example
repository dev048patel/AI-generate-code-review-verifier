# ---- required in production ----
ACRV_PRODUCTION=true
ACRV_PUBLIC_URL=https://acrv.example.com
POSTGRES_PASSWORD=change-me

# GitHub App (Settings -> Developer settings -> GitHub Apps). Permissions: Contents read,
# Pull requests read & write, Checks read & write, Metadata read. Events: Pull request.
GITHUB_APP_ID=
# PEM contents; newlines may be written as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# The same app's OAuth credentials, for dashboard sign-in. Callback URL: $ACRV_PUBLIC_URL/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- LLM ----
LLM_PROVIDER=anthropic          # anthropic | bedrock | mock
ANTHROPIC_API_KEY=
# ACRV_MODEL_ID=claude-opus-5   # Bedrock default: anthropic.claude-opus-5 (set AWS_REGION + AWS credentials)
# ACRV_PRICE_PER_MTOK=5,25      # override cost accounting, e.g. for Bedrock pricing
ACRV_MONTHLY_BUDGET_USD=50      # per GitHub account the app is installed on

# ---- sandbox ----
ACRV_SANDBOX=docker
ACRV_SANDBOX_IMAGE=acrv-sandbox:latest
# ACRV_DOCKER_RUNTIME=runsc     # gVisor; strongly recommended

# ---- behaviour / ops ----
ACRV_CHECK_FAIL_BELOW=0         # make the check fail below this trust score (0 = never block)
ACRV_METRICS_TOKEN=

# ---- Repo Atlas ----
ACRV_TRACE_TOKEN=               # apps send "Authorization: Bearer <this>" to POST /v1/traces (required in production)
ACRV_ATLAS_API_TOKEN=           # the browser extension's token for Atlas read endpoints
# ACRV_ATLAS_MAX_COMMITS=150
