{
  "manifest_version": 3,
  "name": "Repo Atlas for GitHub",
  "version": "0.1.0",
  "description": "See what a pull request changes in a repo's structure — new gaps, broken imports, removed routes — before you merge it.",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Repo Atlas", "default_popup": "options.html" }
}
